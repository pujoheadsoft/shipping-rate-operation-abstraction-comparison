opam-version: "2.0"
synopsis: "Shipping-rate comparison using OCaml application effects and Eio"
maintainer: "comparison project"
authors: "comparison project"
license: "LicenseRef-UNLICENSED"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: ["dune" "runtest" "-p" name "-j" jobs]
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.20"}
  "eio" {>= "1.3"}
  "eio_main" {>= "1.3"}
  "piaf" {>= "0.2.0" & < "0.3"}
  "yojson" {>= "2.2"}
  "alcotest" {with-test & >= "1.9"}
]
